{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://documentation-toolkit.local/schemas/user-doc-frontmatter.schema.json",
  "title": "User documentation frontmatter",
  "type": "object",
  "required": ["title"],
  "properties": {
    "title": { "type": "string", "minLength": 3 },
    "description": { "type": "string", "minLength": 10 },
    "audience": {
      "type": ["string", "array"],
      "items": { "type": "string" }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string" }
    },
    "screenshots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "updated": { "type": "string" },
    "related": {
      "type": "array",
      "items": { "type": "string" }
    },
    "draft": { "type": "boolean" }
  },
  "additionalProperties": true
}
